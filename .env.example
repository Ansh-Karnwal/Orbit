ORBIT_MODE=fixture                  # default task mode: fixture | live
ORBIT_ALLOW_RESET=1                 # /demo/reset allowed
ORBIT_AUTH_MODE=demo                # demo: anonymous = demo_user | required: 401 until signed in
ORBIT_TEXT_APPROVALS=0              # 1 = the task owner may reply "YES" / "NO" (or "YES <hash8>") by text
ORBIT_TEXT_INTAKE=0                 # 1 = a request texted from LIVE_USER_HANDLE starts a task
ORBIT_PROVIDER_CONFIRM=0            # 1 = after approval, text the provider and book only on their YES
ORBIT_CORS_ORIGINS=http://localhost:3000   # comma-separated frontend origins (sign-in cookie needs exact origins)
DATABASE_URL=sqlite:///./orbit.db
ARTIFACT_DIR=./artifacts
LLM_MODE=fixture                    # fixture (rule-based, offline) | live
LLM_PROVIDER=anthropic             # anthropic | openai
LLM_MODEL=                          # set to the model id you use; verify against provider docs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                     # for LLM_PROVIDER=openai
MESSAGING_MODE=fixture              # fixture | photon
PHOTON_API_KEY=                     # Photon Beta key (see docs/integrations.md)
PHOTON_PROJECT_ID=                  # pho_prj_… (Beta project)
PHOTON_AGENT_HANDLE=                # the shared line assigned to the project (display only)
PHOTON_POLL_S=2                     # inbound polling interval, seconds
PHOTON_BRIDGE_URL=http://localhost:8200   # only if photon-bridge sidecar is used
LIVE_PROVIDER_A_HANDLE=             # consenting teammate's number/handle
LIVE_PROVIDER_B_HANDLE=
LIVE_USER_HANDLE=                   # the demo user's own number, for Orbit's reports (must text the line first)
BROWSER_MODE=fixture                # fixture | browser_use
BROWSER_USE_API_KEY=
BROWSER_USE_HEADLESS=0
BROWSER_USE_LLM=auto                # auto | browser_use | anthropic
BROWSER_USE_MODEL=
BROWSER_USE_MAX_STEPS=25
BROWSER_USE_TIMEOUT_S=120
PORTAL_BASE_URL=http://localhost:8100
FIXTURE_AUTO_FOLLOWUPS=0            # 1 = Provider A's price change auto-arrives
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
