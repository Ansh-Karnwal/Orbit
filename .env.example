ORBIT_MODE=fixture                  # default task mode: fixture | live
ORBIT_ALLOW_RESET=1                 # /demo/reset allowed
DATABASE_URL=sqlite:///./orbit.db
ARTIFACT_DIR=./artifacts
LLM_MODE=fixture                    # fixture (rule-based, offline) | live
LLM_PROVIDER=anthropic
LLM_MODEL=                          # set to the model id you use; verify against provider docs
ANTHROPIC_API_KEY=
MESSAGING_MODE=fixture              # fixture | photon
PHOTON_API_KEY=                     # final var names set by Ansh after checking Photon docs
PHOTON_BRIDGE_URL=http://localhost:8200   # only if photon-bridge sidecar is used
LIVE_PROVIDER_A_HANDLE=             # consenting teammate's number/handle
LIVE_PROVIDER_B_HANDLE=
BROWSER_MODE=fixture                # fixture | browser_use
BROWSER_USE_API_KEY=
PORTAL_BASE_URL=http://localhost:8100
FIXTURE_AUTO_FOLLOWUPS=0            # 1 = Provider A's price change auto-arrives
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=0
SENTRY_DSN=
